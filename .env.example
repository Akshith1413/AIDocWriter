# Application
APP_NAME=Aureview AI
APP_ENV=development
SECRET_KEY=replace-this-with-a-long-random-production-secret
DATABASE_URL=sqlite:///./aureview.db
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
GUEST_DAILY_LIMIT=3

# Default provider. "demo" works offline with no key.
DEFAULT_PROVIDER=demo
DEFAULT_MODEL=studio-demo

# Optional cloud AI providers. Configure only on the backend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
XAI_API_KEY=
XAI_MODEL=grok-4.3

